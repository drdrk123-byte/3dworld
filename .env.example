# Actual secrets belong in Vercel Environment Variables, never public/.
# Disabled by default: only enable after checking your billing settings.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
# A separate random teacher access code (32+ characters), not your API key.
APP_ACCESS_TOKEN=

# Student world list storage (Firestore) + teacher Google login. Server-side only.
# From the Firebase service-account JSON (Project settings > Service accounts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# OAuth Web client ID (Google Cloud Console > Credentials). Public value, not a secret.
GOOGLE_CLIENT_ID=
# Comma-separated Google accounts allowed to publish worlds.
TEACHER_EMAILS=
